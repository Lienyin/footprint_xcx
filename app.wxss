.quan {
  align-items: center;
  font-size: 20rpx;
  margin: 12rpx 0;
}
.quan .ticket {
  font-size: 20rpx;
  margin-right: 8rpx;
}
.quan .ticket,
.quan .ticket .l {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.quan .ticket .l {
  background: linear-gradient(270deg, #ff4300, #ff733c);
  border: 2rpx solid #ff733c;
  border-radius: 6rpx 0 0 6rpx;
  border-right: none;
  color: #fff;
  margin-left: -1rpx;
}
.quan .ticket .l,
.quan .ticket .r {
  height: 37rpx;
  line-height: 36rpx;
  padding: 0 6rpx;
}
.quan .ticket .r {
  align-items: center;
  border: 2rpx solid #ff733c;
  border-radius: 0 6rpx 6rpx 0;
  color: #ff4300;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.quan .sheng {
  overflow: hidden;
}
.quan .sheng > view {
  font-size: 20rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
}
.quan .sheng > view:first-child {
  background-color: #fc500e;
  border-radius: 6rpx 0 0 6rpx;
  color: #fff;
  padding: 0 6rpx;
}
.quan .sheng > view:last-child {
  background-color: #fff1e3;
  border-radius: 0 6rpx 6rpx 0;
  color: #ff4300;
  padding: 0 6rpx 0 24rpx;
  position: relative;
}
.quan .sheng > view:last-child .xiexian {
  border-color: #fc500e #fff1e3 #fff1e3 #fc500e;
  border-style: solid;
  border-width: 20rpx 9rpx;
  display: block;
  height: 0;
  left: -2rpx;
  position: absolute;
  top: 0;
  width: 0;
}
.quan .sheng > view:last-child .shake {
  background: url(https://cdn.file.jdds.com/system/shop/shop/static/sheng_icon.png)
    no-repeat;
  background-size: 100% 100%;
  height: inherit;
  left: -2rpx;
  position: absolute;
  top: 0;
  transform: skewX(-4deg);
  width: 18rpx;
  z-index: 1;
}
