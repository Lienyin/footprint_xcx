.nvBox {
  background-color: hsla(0, 0%, 100%, 0.5);
  margin: 0rpx auto;
  max-height: 68rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.nvBox,
.nvBox view {
  border-radius: 36rpx;
}
.nvBox view {
  align-items: center;
  color: #222;
  font-size: 32rpx;
  height: 100%;
  line-height: 68rpx;
  padding: 0 26rpx;
  transition: all 0.3s;
}
.nvBox view .icon {
  display: inline-block;
  height: 40rpx;
  margin-right: 12rpx;
  width: 40rpx;
}
.nvBox view.active {
  background-color: #fff;
}
.nvBox view.active .icon {
  animation: myline1 0.3s linear 0s 1;
}
@-webkit-keyframes myline1 {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.8);
  }
  100% {
    transform: scale(1);
  }
}
@keyframes myline1 {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.8);
  }
  100% {
    transform: scale(1);
  }
}
