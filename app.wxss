.el-loading-parent--relative {
  position: relative !important;
}
.el-loading-mask {
  background-color: #fff;
  border-radius: 20rpx;
  bottom: 0;
  left: 0;
  margin: 0;
  position: absolute;
  right: 0;
  top: 0;
  transition: opacity 0.3s;
  z-index: 2;
}
.el-loading-mask .el-loading-spinner {
  margin-top: -41rpx;
  position: absolute;
  text-align: center;
  top: 50%;
  width: 100%;
}
.el-loading-mask .el-loading-spinner .el-loading-text {
  color: #222;
  font-size: 24rpx;
  margin: 3rpx 0;
}
.el-loading-mask .el-loading-spinner .circular {
  animation: loading-rotate 2s linear infinite;
  height: 62rpx;
  width: 62rpx;
}
.el-loading-mask .el-loading-spinner .path {
  stroke-dasharray: 90, 150;
  stroke-dashoffset: 0;
  stroke-width: 2;
  stroke: #222;
  stroke-linecap: round;
  animation: loading-dash 1.5s ease-in-out infinite;
}
.el-loading-mask .el-loading-spinner ._i {
  color: #222;
}
.el-loading-mask .el-loading-fade-enter,
.el-loading-mask .el-loading-fade-leave-active {
  opacity: 0;
}
@-webkit-keyframes loading-rotate {
  to {
    transform: rotate(1turn);
  }
}
@keyframes loading-rotate {
  to {
    transform: rotate(1turn);
  }
}
@-webkit-keyframes loading-dash {
  0% {
    stroke-dasharray: 1, 200;
    stroke-dashoffset: 0;
  }
  50% {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -40rpx;
  }
  to {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -120rpx;
  }
}
@keyframes loading-dash {
  0% {
    stroke-dasharray: 1, 200;
    stroke-dashoffset: 0;
  }
  50% {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -40rpx;
  }
  to {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -120rpx;
  }
}
