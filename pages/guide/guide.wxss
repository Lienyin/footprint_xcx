.guide-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.guide-swiper {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.guide-image {
  width: 100%;
  height: 100%;
}

.dialog-box {
  position: absolute;
  width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 20;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 第1步：居中 */
.position-1 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 第2步：中间偏上 */
.position-2 {
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 第3步：居中 */
.position-3 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 第4步：顶部 */
.position-4 {
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx;
}

/* 第5步：顶部 */
.position-5 {
  top: 300rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 第6步：顶部 */
.position-6 {
  top: 300rpx;
  left: 50%;
  transform: translateX(-50%);
}

.step-indicator {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.dialog-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
  min-height: 120rpx;
}

.button-area {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.skip-btn {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 20rpx;
  margin-right: auto;
}

.next-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 2rpx 68rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.next-btn.primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
}

.next-btn::after {
  border: none;
}
