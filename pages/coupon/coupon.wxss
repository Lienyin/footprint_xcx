/* 页面整体样式 */  
.coupon-page {  
  background-color: #f5f7fa;  
  min-height: 100vh;  
  padding-bottom: 120rpx;  
}  

/* 标签栏样式 */  
.tab-container {  
  display: flex;  
  background-color: #fff;  
  padding: 20rpx 0;  
  position: sticky;  
  top: 0;  
  z-index: 10;  
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}  

.tab-item {  
  flex: 1;  
  text-align: center;  
  font-size: 28rpx;  
  color: #666;  
  position: relative;  
  padding: 20rpx 0;  
}  

.tab-item.active {  
  color: #e4393c;  /* 主色调 */
  font-weight: 500;  
}  

.tab-item.active:after {  
  content: '';  
  position: absolute;  
  bottom: 0;  
  left: 50%;  
  transform: translateX(-50%);  
  width: 40rpx;  
  height: 4rpx;  
  background-color: #e4393c;  /* 主色调 */
  border-radius: 2rpx;  
}  

.badge {  
  position: absolute;  
  top: 10rpx;  
  right: 50rpx;  
  background-color: #e4393c;  /* 主色调 */
  color: #fff;  
  font-size: 20rpx;  
  min-width: 32rpx;  
  height: 32rpx;  
  line-height: 32rpx;  
  text-align: center;  
  border-radius: 16rpx;  
  padding: 0 6rpx;  
}  

/* 优惠券列表样式 */  
.coupon-list {  
  padding: 30rpx 24rpx;  
}  

.coupon-item {  
  position: relative;  
  display: flex;  
  margin-bottom: 30rpx;  
  background: #fff;  
  border-radius: 16rpx;  
  overflow: hidden;  
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);  
}  

.coupon-item:before {  
  content: '';  
  position: absolute;  
  left: 180rpx;  
  top: 0;  
  bottom: 0;  
  border-left: 2rpx dashed #eee;  
}  

.coupon-item:after {  
  content: '';  
  position: absolute;  
  left: 180rpx;  
  top: -12rpx;  
  width: 24rpx;  
  height: 24rpx;  
  border-radius: 50%;  
  background: #f5f7fa;  
}  

.coupon-item:before {  
  content: '';  
  position: absolute;  
  left: 180rpx;  
  bottom: -12rpx;  
  width: 24rpx;  
  height: 24rpx;  
  border-radius: 50%;  
  background: #f5f7fa;  
}  

/* 优惠券左侧金额样式 */  
.coupon-left {  
  width: 180rpx;  
  padding: 50rpx 0;  
  text-align: center;  
  display: block;
  justify-content: center;  
  align-items: center;
}  

.currency {  
  font-size: 28rpx;  
  color: #e4393c;  /* 主色调 */
  font-weight: bold;  
  display: inline-block;  
  vertical-align: middle;
  margin-right: 4rpx;  
}  

.amount {  
  font-size: 60rpx;  
  color: #e4393c;  /* 主色调 */
  font-weight: bold;  
  line-height: 1;  
  display: inline-block;  
  vertical-align: middle;
}  

.discount-unit {  
  font-size: 28rpx;  
  color: #e4393c;  /* 主色调 */
  font-weight: bold;  
  margin-left: 4rpx;  
}  

.condition {  
  font-size: 22rpx;  
  color: #999;  
  margin-top: 10rpx;  
  text-align: center;
}  

/* 优惠券右侧信息样式 */  
.coupon-right {  
  flex: 1;  
  padding: 20rpx 20rpx;  
  position: relative;  
  padding-right: 80rpx; /* 右侧留出按钮空间 */  
}  

.coupon-name {  
  font-size: 30rpx;  
  color: #333;  
  font-weight: 500;  
  margin-bottom: 12rpx;  
  white-space: nowrap;  
  overflow: hidden;  
  text-overflow: ellipsis;  
}  

.coupon-time {  
  font-size: 22rpx;  
  color: #999;  
  margin-bottom: 12rpx;  
}  

.inflate-btn {  
  position: absolute;  
  right: 20rpx;  
  bottom: 80rpx;  
  background: #e4393c;  /* 主色调 */
  color: #fff;  
  font-size: 24rpx;  
  padding: 10rpx 20rpx;  
  border-radius: 30rpx;  
}  

.status-mark {  
  position: absolute;  
  right: 20rpx;  
  bottom: 30rpx;  
  font-size: 24rpx;  
  color: #999;  
}  

/* 优惠券类型标签 */  
.coupon-tag {  
  position: absolute;  
  top: 0;  
  left: 0;  
  background: #e4393c;  /* 主色调 */
  color: #fff;  
  font-size: 20rpx;  
  padding: 6rpx 12rpx;  
  border-radius: 0 0 16rpx 0;  
  z-index: 1;  
}  

/* 不同类型的优惠券使用不同色调，但保持在红色系内 */
.coupon-tag.discount {  
  background: #ff6666;  /* 浅红色 */
}  

.coupon-tag.free {  
  background: #cc3333;  /* 深红色 */
}  

.coupon-tag.inflate {  
  background: #aa0000;  /* 暗红色 */
}

/* 可赠送标记 */  
.gift-tag {  
  position: absolute;  
  top: 20rpx;  
  right: 20rpx;  
  display: flex;  
  align-items: center;  
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
  min-height: 0;
  margin: 0;
  box-shadow: none;
  border-radius: 0;
}  

/* 处理微信小程序按钮的默认样式 */  
.gift-tag::after {  
  border: none;  
  background: none;  
}  

.gift-tag image {  
  width: 40rpx;  
  height: 40rpx;  
  margin-right: 8rpx;  
}  

.gift-text {  
  font-size: 24rpx;  
  color: #e4393c;  /* 主色调 */
  text-decoration: underline;  
  font-weight: 500;  
}

/* 已使用和已过期样式 */  
.coupon-item.used,  
.coupon-item.expired {  
  filter: grayscale(100%);  
  opacity: 0.6;  
}  

/* 空状态样式 */  
.empty-state {  
  display: flex;  
  flex-direction: column;  
  align-items: center;  
  justify-content: center;  
  padding: 100rpx 0;  
}  

.empty-state image {  
  width: 200rpx;  
  height: 200rpx;  
  margin-bottom: 20rpx;  
}  

.empty-state text {  
  font-size: 28rpx;  
  color: #999;  
}  

/* 可用的优惠券特效 - 修改为红色系 */  
.coupon-item:not(.used):not(.expired) {  
  box-shadow: 0 4rpx 20rpx rgba(228, 57, 60, 0.1);  
  animation: pulse 2s infinite;  
}  

@keyframes pulse {  
  0% {  
    box-shadow: 0 4rpx 20rpx rgba(228, 57, 60, 0.1);  
  }  
  50% {  
    box-shadow: 0 4rpx 20rpx rgba(228, 57, 60, 0.3);  
  }  
  100% {  
    box-shadow: 0 4rpx 20rpx rgba(228, 57, 60, 0.1);  
  }  
}  

/* 膨胀券动画 */  
.inflate-btn {  
  animation: inflate 1.5s ease-in-out infinite;  
}  

@keyframes inflate {  
  0% {  
    transform: scale(1);  
  }  
  50% {  
    transform: scale(1.1);  
  }  
  100% {  
    transform: scale(1);  
  }  
}  

/* 适配iPhone底部安全区 */  
.safe-bottom {  
  padding-bottom: constant(safe-area-inset-bottom);  
  padding-bottom: env(safe-area-inset-bottom);  
}

/* 优惠券描述展开收起功能 */  
.coupon-desc-container {  
  position: relative;  
  margin-bottom: 20rpx;  
}  

.coupon-desc {  
  font-size: 22rpx;  
  color: #999;  
  overflow: hidden;  
  text-overflow: ellipsis;  
  display: -webkit-box;  
  -webkit-line-clamp: 2; /* 默认显示2行 */  
  -webkit-box-orient: vertical;  
  max-width: 100%;  
  transition: all 0.3s ease;  
}  

.coupon-desc.expanded {  
  -webkit-line-clamp: unset; /* 展开后不限制行数 */  
  max-height: 300rpx; /* 设置一个最大高度，防止内容过长 */  
  overflow-y: auto; /* 允许滚动 */  
}  

.expand-btn {  
  position: absolute;  
  right: 0;  
  bottom: -5rpx;  
  font-size: 22rpx;  
  color: #e4393c;  /* 主色调 */
  background: linear-gradient(to left, #fff 70%, rgba(255,255,255,0.5) 100%);  
  padding-left: 30rpx;  
  padding-right: 0;  
}

/* 悬浮领券按钮容器 */
.floating-coupon-btn {
  position: fixed;
  right: -107rpx; /* 初始隐藏在右侧 */
  bottom: 50%;
  transform: translateY(50%);
  width: 160rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #e4393c 0%, #ff6666 100%);
  border-radius: 12rpx 0 0 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(228, 57, 60, 0.3);
  z-index: 100;
  transition: right 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
}

/* 展开状态：显示完整 */
.floating-coupon-btn.expand {
  right: 0;
}

/* 收起状态：只显示1/3 */
.floating-coupon-btn.collapse {
  right: -107rpx;
}

.floating-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100%;
  color: #fff;
  cursor: pointer;
}

.coupon-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.btn-text {
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
  transition: opacity 0.3s ease;
}

/* 脉冲动画 */
@keyframes floatingPulse {
  0%, 100% {
    box-shadow: 0 4rpx 16rpx rgba(228, 57, 60, 0.3);
  }
  50% {
    box-shadow: 0 6rpx 20rpx rgba(228, 57, 60, 0.5);
  }
}

.floating-coupon-btn.expand {
  animation: floatingPulse 2.5s ease-in-out infinite;
}

.floating-coupon-btn.collapse {
  animation: none;
}