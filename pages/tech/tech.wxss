/* 基本样式 */
.container {
  padding: 30px;
  background-color: #f7f7f7;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

.header {
  text-align: center;
  margin-bottom: 30px;
}

.title {
  font-size: 26px;
  font-weight: bold;
  color: #333;
}

.content {
  margin-top: 20px;
}

/* 输入框组 */
.form-group {
  margin-bottom: 25px;
}

.label {
  font-size: 16px;
  color: #444;
  margin-bottom: 8px;
  display: block;
}

.input {
  padding: 12px 15px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 14px;
}

/* 标签选择 */
.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 10px 15px;
  background-color: #e0e0e0;
  border-radius: 25px;
  margin-right: 10px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: background-color 0.3s;
}

.tag.active {
  background-color: #f84f40;
  color: white;
}

/* 照片上传 */
.image-upload-group {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.upload-box {
  flex: 1 1 calc(20% - 10px);
  padding: 15px;
  border: 1px dashed #ddd;
  border-radius: 8px;
  text-align: center;
  margin-right: 10px;
  margin-bottom: 10px;
  background-color: #fafafa;
  transition: background-color 0.3s;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}

.upload-box .uploaded-preview {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
  z-index: 1;
}

.upload-box text {
  position: relative;
  z-index: 2;
  color: #888;
}

.upload-box:hover {
  background-color: #f0f0f0;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  padding: 12px;
  background-color: #f84f40;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  transition: background-color 0.3s;
}

.submit-btn:hover {
  background-color: #d83830;
}