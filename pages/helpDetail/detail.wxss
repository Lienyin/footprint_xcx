/* pages/helpDetail/detail.wxss */

.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #ff3456;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 文章内容 */
.article-content {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 文章头部 */
.article-header {
  padding: 40rpx 32rpx 24rpx;
}

.article-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 32rpx;
}

/* 文章主体 */
.article-body {
  padding: 32rpx;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  word-wrap: break-word;
}

.article-body image {
  max-width: 100% !important;
  height: auto !important;
  border-radius: 8rpx;
  margin: 16rpx 0;
}

/* 评价区域 */
.feedback-section {
  margin: 20rpx;
  padding: 32rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.feedback-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 24rpx;
  text-align: center;
}

.feedback-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-bottom: 20rpx;
}

.feedback-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background-color: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  min-width: 0;
}

.feedback-btn-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

.btn-helpful {
  border-color: #52c41a;
  background-color: #f6ffed;
}

.btn-not-helpful {
  border-color: #ff4d4f;
  background-color: #fff1f0;
}

.btn-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
  line-height: 1;
}

.btn-text {
  font-size: 26rpx;
  color: #666;
}

.btn-helpful .btn-text {
  color: #52c41a;
  font-weight: 500;
}

.btn-not-helpful .btn-text {
  color: #ff4d4f;
  font-weight: 500;
}

.feedback-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 备注输入框 */
.remark-input {
  margin-top: 16rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #e8e8e8;
}

.remark-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 提交反馈按钮 */
.submit-feedback-btn {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ff6b8a 0%, #ff3456 100%);
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 52, 86, 0.3);
}

.submit-feedback-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 52, 86, 0.2);
}

.submit-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

/* 空状态 */
.empty-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.back-btn {
  padding: 20rpx 48rpx;
  background-color: #fff;
  border: 2rpx solid #ff3456;
  border-radius: 40rpx;
}

.back-btn-text {
  font-size: 28rpx;
  color: #ff3456;
}
