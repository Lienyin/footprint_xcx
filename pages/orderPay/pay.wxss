page {  
  min-height: 100%;  
  background-color: #f6f6f6; /* 与首页背景色统一 */  
}  

.container {  
  background-color: #f6f6f6;  
  min-height: 100%;  
  overflow-x: hidden;  
  position: relative;  
  width: 100%;  
  align-items: stretch;  
  padding-bottom: 200rpx;  
}  

.wrap {  
  width: 100%;  
}  

.goods-list {  
  width: 100%;  
  background-color: #fff;  
  margin-bottom: 20rpx;  
  border-radius: 12rpx; /* 添加圆角 */  
  overflow: hidden; /* 确保内容不超出圆角 */  
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05); /* 添加轻微阴影 */  
}  

.goods-list .list-title {  
  font-size: 28rpx;  
  color: #333; /* 加深颜色 */  
  padding: 24rpx;  
  border-bottom: 1rpx solid #eee;  
  font-weight: 500; /* 稍微加粗 */  
}  

.a-goods {  
  display: flex;  
  padding: 24rpx;  
  background-color: #fff;  
  justify-content: space-between;  
}  

.img-box {  
  height: 120rpx; /* 增加高度 */  
  display: flex;  
  justify-content: flex-start;  
}  

.image-wrap {  
  margin-right: 12rpx;  
}  

.goods-image {  
  width: 120rpx; /* 增加尺寸 */  
  height: 120rpx;  
  border-radius: 8rpx; /* 添加圆角 */  
  background-color: #fafafa;  
}  

.goods-sum {  
  line-height: 120rpx;  
  height: 120rpx;  
  font-size: 26rpx;  
  color: #666;  
  display: flex;  
  justify-content: flex-end;  
  align-items: center;  
}  

.goods-sum .text {  
  margin-right: 20rpx;  
}  

.price-check-wrap {  
  background-color: #fff;  
  padding: 0 0 0 24rpx;  
  margin-bottom: 20rpx;  
  border-radius: 12rpx; /* 添加圆角 */  
  overflow: hidden;  
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05); /* 添加轻微阴影 */  
}  

.row-box {  
  display: flex;  
  justify-content: space-between;  
  align-items: center;  
  box-sizing: border-box;  
  border-bottom: 1rpx solid #f6f6f6; /* 浅一些的分隔线 */  
  padding: 0 24rpx 0 0;  
  height: 90rpx;  
}  

.row-label {  
  width: 160rpx;  
  font-size: 28rpx;  
  color: #333; /* 加深颜色 */  
  font-weight: 500; /* 稍微加粗 */  
}  

.right-text {  
  font-size: 28rpx;  
  color: #666;  
  display: flex;  
  flex-direction: column;  
  align-items: flex-end;  
}  

.color-red {  
  color: #e4393c; /* 统一红色系 */  
}  

.memo-box {  
  display: flex;  
  justify-content: flex-start;  
  align-items: center;  
  box-sizing: border-box;  
  border-bottom: 1rpx solid #f6f6f6;  
  padding: 0 24rpx 0 0;  
  height: 90rpx;  
}  

.memo-input {  
  margin-left: 8rpx;  
  width: 100%;  
}  

.memo {  
  height: 20rpx;  
  text-align: right;  
  color: #333;  
}  

/* 底部结算栏 */  
.settle-box {  
  display: flex;  
  justify-content: space-between;  
  width: 100%;  
  height: 110rpx;  
  position: fixed;  
  bottom: 0;  
  left: 0;  
  border-top: 1px solid #f6f6f6;  
  background-color: #fff;  
  padding-bottom: env(safe-area-inset-bottom);  
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);  
}  

/* 优化左侧价格区域 */  
.settle-box .left-price {  
  display: flex;  
  flex: 1;  
  justify-content: flex-start;  
  align-items: center;  
  line-height: normal;  
  font-size: 28rpx;  
  padding: 0 0 0 30rpx;  
}  

.settle-box .total {  
  color: #333;  
  font-size: 28rpx;  
  margin-right: 8rpx;  
}  

.settle-box .pay-money {  
  color: #e4393c;  
  font-size: 40rpx;  
  font-weight: bold;  
}  

.settle-box .save-section {  
  display: flex;  
  align-items: baseline;  
  margin-left: 16rpx;  
}  

.settle-box .save {  
  color: #999;  
  font-size: 24rpx;  
}  

.settle-box .save-money {  
  color: #e4393c;  
  font-size: 24rpx;  
  font-weight: bold;  
}  

/* 按钮容器 */  
.settle-btns-container {  
  display: flex;  
  align-items: center;  
  justify-content: flex-end;  
  padding-right: 30rpx;  
}  

/* 结算付款按钮 - 主按钮 */  
.settle-box .to-pay-btn {  
  height: 80rpx;  
  line-height: 80rpx;  
  font-size: 28rpx;  
  color: #fff;  
  background-color: #e4393c;  
  border-radius: 40rpx;  
  padding: 0 40rpx;  
  margin-left: 20rpx;  
  box-shadow: 0 4rpx 8rpx rgba(228, 57, 60, 0.2);  
  border: none;  
}  

/* 完全去除所有按钮的默认边框 */  
.settle-box button {  
  border: none !important;  
  outline: none !important;  
  -webkit-appearance: none !important;  
  -webkit-tap-highlight-color: transparent !important;  
}  

/* 重要：去掉微信小程序按钮默认样式 */  
.settle-box button::after {  
  border: none !important;  
  display: none !important;  
}  

/* 他人代付按钮 - 链接风格（修改为水平布局） */  
.settle-box .to-share-btn {  
  font-size: 26rpx;  
  color: #666;  
  background-color: transparent !important;  
  padding: 0 15rpx;  
  margin: 0;  
  height: auto;  
  min-height: auto;  
  box-shadow: none;  
  display: flex;  
  flex-direction: row; /* 改为水平方向布局 */  
  align-items: center;  
  justify-content: center;  
  line-height: normal;  
}  

/* 分享图标样式 */  
.share-icon {  
  width: 32rpx;  
  height: 32rpx;  
  margin-right: 8rpx; /* 图标和文字之间的间距 */  
}  

/* 分享按钮文字 */  
.share-text {  
  font-size: 26rpx;  
  color: #666;  
  text-decoration: underline;  
  text-decoration-color: #666;  
  text-decoration-thickness: 1px;  
}  

/* 按钮互动效果 */  
.settle-box button:active {  
  opacity: 0.9;  
}  

/* 手机号授权弹窗样式 */  
.phone-modal {  
  position: fixed;  
  top: 0;  
  left: 0;  
  width: 100%;  
  height: 100%;  
  z-index: 1000;  
  visibility: hidden;  
  opacity: 0;  
  transition: all 0.3s ease;  
}  

.phone-modal.show {  
  visibility: visible;  
  opacity: 1;  
}  

.modal-mask {  
  position: absolute;  
  top: 0;  
  left: 0;  
  width: 100%;  
  height: 100%;  
  background-color: rgba(0, 0, 0, 0.6);  
}  

.modal-content {  
  position: absolute;  
  top: 20%;  
  left: 50%;  
  transform: translate(-50%, -50%);  
  width: 600rpx;  
  background-color: #fff;  
  border-radius: 16rpx;  
  overflow: hidden;  
}  

.modal-header {  
  position: relative;  
  padding: 30rpx 0;  
  text-align: center;  
  border-bottom: 1rpx solid #f0f0f0;  
}  

.modal-title {  
  font-size: 32rpx;  
  font-weight: 500;  
  color: #333;  
}  

.modal-close {  
  position: absolute;  
  right: 30rpx;  
  top: 25rpx;  
  font-size: 40rpx;  
  color: #999;  
  line-height: 1;  
}  

.modal-body {  
  padding: 40rpx 50rpx;  
}  

.auth-tip {  
  text-align: center;  
  font-size: 28rpx;  
  color: #666;  
  margin-bottom: 40rpx;  
}  

.auth-btn {  
  width: 100%;  
  height: 88rpx;  
  background-color: #07c160;  
  color: #fff;  
  border-radius: 44rpx;  
  font-size: 30rpx;  
  display: flex;  
  align-items: center;  
  justify-content: center;  
  margin-bottom: 30rpx;  
  border: none;  
}  

.auth-btn::after {  
  border: none;  
}  

.auth-btn.loading {  
  opacity: 0.8;  
}  

.cancel-btn {  
  text-align: center;  
  font-size: 28rpx;  
  color: #999;  
  padding: 10rpx;  
}  

/* 订单备注样式 */  
.memo-section {  
  flex: 1;  
  display: flex;  
  align-items: center;  
}  

.memo-placeholder {  
  color: #999;  
  font-size: 28rpx;  
}  

.memo-input {  
  flex: 1;  
  text-align: right;  
  font-size: 28rpx;  
  color: #333;  
}  

/* 优化金额显示 */  
.money-text {  
  font-weight: bold;  
}  

/* 商品信息样式 */  
.goods-info {  
  flex: 1;  
  padding-left: 20rpx;  
  display: flex;  
  flex-direction: column;  
  justify-content: space-between;  
  height: 120rpx;  
}  

.goods-title {  
  font-size: 28rpx;  
  color: #333;  
  line-height: 1.3;  
  margin-bottom: 8rpx;  
  overflow: hidden;  
  text-overflow: ellipsis;  
  display: -webkit-box;  
  -webkit-line-clamp: 2;  
  -webkit-box-orient: vertical;  
}  

.goods-props {  
  font-size: 24rpx;  
  color: #999;  
  margin-bottom: 8rpx;  
}  

.goods-price-num {  
  display: flex;  
  justify-content: space-between;  
  font-size: 24rpx;  
  color: #666;  
}  

.goods-price {  
  color: #e4393c;  
  font-weight: 500;  
}  

/* 订单摘要样式 */  
.order-summary {  
  padding: 24rpx;  
  background-color: #fff;  
  margin-bottom: 20rpx;  
  border-radius: 12rpx;  
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);  
}  

.summary-title {  
  font-size: 28rpx;  
  color: #333;  
  font-weight: 500;  
  margin-bottom: 16rpx;  
}  

.summary-row {  
  display: flex;  
  justify-content: space-between;  
  align-items: center;  
  margin-bottom: 12rpx;  
  font-size: 26rpx;  
  color: #666;  
}  

.summary-row:last-child {  
  margin-bottom: 0;  
}  

/* 收货地址样式 */  
.address-container {  
  background-color: #fff;  
  margin-bottom: 20rpx;  
  border-radius: 12rpx;  
  overflow: hidden;  
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);  
}  

.address-box {  
  padding: 24rpx;  
  display: flex;  
  align-items: center;  
}  

.address-info {  
  flex: 1;  
}  

.address-name-phone {  
  display: flex;  
  font-size: 28rpx;  
  color: #333;  
  margin-bottom: 8rpx;  
  font-weight: 500;  
}  

.address-name {  
  margin-right: 24rpx;  
}  

.address-detail {  
  font-size: 26rpx;  
  color: #666;  
  line-height: 1.4;  
}  

.address-arrow {  
  margin-left: 16rpx;  
  color: #999;  
}  

.add-address {  
  padding: 24rpx;  
  display: flex;  
  align-items: center;  
  justify-content: center;  
  color: #e4393c;  
  font-size: 28rpx;  
}  

.add-address-icon {  
  margin-right: 8rpx;  
  font-size: 32rpx;  
}  

/* 支付方式样式 */  
.payment-method {  
  display: flex;  
  align-items: center;  
}  

.payment-icon {  
  width: 40rpx;  
  height: 40rpx;  
  margin-right: 12rpx;  
}  

.payment-name {  
  font-size: 28rpx;  
  color: #333;  
}  

/* 商品标题 */  
.goods-section-title {  
  font-size: 28rpx;  
  color: #333;  
  padding: 24rpx;  
  font-weight: 500;  
}  

/* 优化分割线 */  
.divider {  
  height: 1rpx;  
  background-color: #f6f6f6;  
  margin: 0 24rpx;  
}  

/* 商品列表容器 */  
.goods-items {  
  padding: 0 24rpx;  
}  

/* 空状态样式 */  
.empty-state {  
  padding: 60rpx 0;  
  text-align: center;  
}  

.empty-icon {  
  width: 160rpx;  
  height: 160rpx;  
  margin-bottom: 20rpx;  
}  

.empty-text {  
  font-size: 28rpx;  
  color: #999;  
}  

/* 按钮和交互效果 */  
.tap-effect:active {  
  opacity: 0.8;  
}  

/* 加载状态 */  
.loading {  
  text-align: center;  
  padding: 30rpx 0;  
  color: #999;  
  font-size: 26rpx;  
}  

/* 订单提交成功页面 */  
.success-page {  
  display: flex;  
  flex-direction: column;  
  align-items: center;  
  padding: 60rpx 40rpx;  
  background-color: #fff;  
  border-radius: 12rpx;  
  margin: 20rpx;  
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);  
}  

.success-icon {  
  width: 120rpx;  
  height: 120rpx;  
  margin-bottom: 30rpx;  
}  

.success-title {  
  font-size: 32rpx;  
  color: #333;  
  font-weight: 500;  
  margin-bottom: 20rpx;  
}  

.success-info {  
  font-size: 28rpx;  
  color: #666;  
  margin-bottom: 40rpx;  
  text-align: center;  
  line-height: 1.5;  
}  

.success-buttons {  
  display: flex;  
  width: 100%;  
  justify-content: space-between;  
}  

.success-btn {  
  width: 48%;  
  height: 80rpx;  
  line-height: 80rpx;  
  border-radius: 40rpx;  
  font-size: 28rpx;  
  text-align: center;  
}  

.primary-btn {  
  background-color: #e4393c;  
  color: #fff;  
}  

.secondary-btn {  
  background-color: #f5f5f5;  
  color: #666;  
  border: 1rpx solid #ddd;  
}  

/* 适配 iPhone X 等设备的底部安全区域 */  
.safe-bottom-area {  
  padding-bottom: env(safe-area-inset-bottom);  
}  

/* 响应式调整 */  
@media screen and (min-width: 768px) {  
  .modal-content {  
    width: 650rpx;  
  }  
  
  .success-page {  
    width: 80%;  
    margin: 40rpx auto;  
  }  
}
/* 优惠券选择行样式 */  
.coupon-select {  
  position: relative;  
}  

.coupon-info {  
  display: flex;  
  align-items: center;  
}  

.coupon-name {  
  max-width: 400rpx;  
  overflow: hidden;  
  text-overflow: ellipsis;  
  white-space: nowrap;  
}  

.coupon-hint {  
  color: #999; /* 统一红色系 */  
}  

.coupon-arrow {  
  margin-left: 10rpx;  
  color: #999;  
}  

.discount-price {  
  font-size: 24rpx;  
  color: #666;  
  margin-top: 4rpx;  
}  

.coupon-value-container {  
  display: flex;  
  align-items: center;  
  justify-content: flex-end;  
}  

/* 修复优惠券弹窗样式 */  
.coupon-modal {  
  position: fixed;  
  top: 0;  
  left: 0;  
  width: 100%;  
  height: 100%;  
  z-index: 1000;  
  visibility: hidden;  
  opacity: 0;  
  transition: all 0.3s ease;  
}  

.coupon-modal.show {  
  visibility: visible;  
  opacity: 1;  
}  

.modal-mask {  
  position: absolute;  
  top: 0;  
  left: 0;  
  width: 100%;  
  height: 100%;  
  background-color: rgba(0, 0, 0, 0.6);  
}  

.coupon-modal .modal-content {  
  position: absolute;  
  bottom: 0;  
  left: 0;  
  right: 0; /* 确保右侧对齐 */  
  width: 100%; /* 确保100%宽度 */  
  max-height: 85vh;  
  background-color: #f8f8f8;  
  border-radius: 24rpx 24rpx 0 0;  
  overflow: hidden;  
  display: flex;  
  flex-direction: column;  
  transform: translateY(0); /* 初始位置 */  
  animation: slideUp 0.3s ease;  
}  

@keyframes slideUp {  
  from { transform: translateY(100%); }  
  to { transform: translateY(0); }  
}  

.modal-header {  
  position: relative;  
  padding: 30rpx 0;  
  text-align: center;  
  background-color: #fff;  
  border-bottom: 1rpx solid #f0f0f0;  
}  

.modal-title {  
  font-size: 32rpx;  
  font-weight: 500;  
  color: #333;  
}  

.modal-close {  
  position: absolute;  
  right: 30rpx;  
  top: 25rpx;  
  font-size: 40rpx;  
  color: #999;  
  line-height: 1;  
}  

.coupon-list {  
  max-height: 70vh;  
  padding: 0 20rpx 20rpx;  
  overflow-y: auto;  
  width: 100%; /* 确保宽度100% */  
  box-sizing: border-box; /* 保证padding不会使内容溢出 */  
}  

/* 不使用优惠券选项 - 重新设计 */  
.no-use-coupon {  
  display: flex;  
  justify-content: space-between;  
  align-items: center;  
  padding: 30rpx 24rpx;  
  background-color: #fff;  
  margin: 20rpx 0;  
  border-radius: 12rpx;  
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);  
  border-left: 8rpx solid #cccccc;  
}  

.no-use-coupon.selected {  
  border-left: 8rpx solid #e4393c;  
  background-color: #fff9f9;  
}  

.no-use-text {  
  font-size: 30rpx;  
  color: #333;  
  font-weight: 500;  
}  

/* 分区标题 */  
.section-title {  
  font-size: 28rpx;  
  color: #333;  
  font-weight: 500;  
  margin: 30rpx 10rpx 20rpx;  
  position: relative;  
  padding-left: 20rpx;  
}  

.section-title:before {  
  content: '';  
  position: absolute;  
  left: 0;  
  top: 6rpx;  
  height: 28rpx;  
  width: 6rpx;  
  background-color: #e4393c;  
  border-radius: 3rpx;  
}  

.section-title.unusable {  
  color: #999;  
}  

.section-title.unusable:before {  
  background-color: #999;  
}  

.coupon-item {  
  margin-bottom: 20rpx;  
  border-radius: 12rpx;  
  position: relative;  
  background: #fff;  
  overflow: hidden;  
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);  
}  

.coupon-item.selected {  
  border: 2rpx solid #e4393c;  
  box-shadow: 0 2rpx 10rpx rgba(228, 57, 60, 0.15);  
  background-color: #fff9f9;  
}  

.coupon-item.disabled {  
  background: #f5f5f5;  
}  

.coupon-item-inner {  
  display: flex;  
  padding: 24rpx;  
  position: relative;  
}  

.coupon-item-inner:before {  
  content: '';  
  position: absolute;  
  left: 0;  
  top: 0;  
  height: 100%;  
  width: 8rpx;  
  background-color: #e4393c;  
  border-radius: 4rpx 0 0 4rpx;  
}  

.coupon-item.disabled .coupon-item-inner:before {  
  background-color: #999;  
}  

.coupon-left {  
  display: flex;  
  flex-direction: column;  
  justify-content: center;  
  align-items: center;  
  padding-right: 20rpx;  
  min-width: 180rpx;  
  border-right: 1rpx dashed #eee;  
}  

.coupon-value {  
  font-size: 40rpx;  
  color: #e4393c;  
  font-weight: bold;  
  margin-bottom: 8rpx;  
  display: flex;  
  align-items: flex-start;  
}  

/* 增大¥符号尺寸 */  
.currency-symbol {  
  font-size: 32rpx;  
  margin-right: 2rpx;  
  font-weight: normal;  
}  

.discount-unit {  
  font-size: 24rpx;  
  font-weight: normal;  
  margin-left: 2rpx;  
}  

.coupon-item.disabled .coupon-value {  
  color: #999;  
}  

.coupon-condition {  
  font-size: 22rpx;  
  color: #999;  
  text-align: center;  
}  

.coupon-middle {  
  flex: 1;  
  padding: 0 20rpx;  
  display: flex;  
  flex-direction: column;  
  justify-content: center;  
}  

.coupon-middle .coupon-name {  
  font-size: 28rpx;  
  color: #333;  
  font-weight: 500;  
  margin-bottom: 12rpx;  
  line-height: 1.3;  
}  

.coupon-item.disabled .coupon-name {  
  color: #999;  
}  

.coupon-time {  
  font-size: 22rpx;  
  color: #999;  
  margin-bottom: 8rpx;  
  line-height: 1.3;  
}  

.coupon-desc {  
  font-size: 22rpx;  
  color: #999;  
  margin-bottom: 8rpx;  
  line-height: 1.3;  
}  

.coupon-reason {  
  font-size: 22rpx;  
  color: #e4393c;  
  margin-top: 8rpx;  
  line-height: 1.3;  
}  

.coupon-tag-container {  
  display: flex;  
  flex-wrap: wrap;  
  margin-top: 6rpx;  
}  
.coupon-tag {  
  font-size: 20rpx;  
  color: #e4393c;  
  background-color: rgba(228, 57, 60, 0.1);  
  padding: 4rpx 10rpx;  
  border-radius: 4rpx;  
  margin-right: 8rpx;  
  margin-top: 8rpx;  
  line-height: 1.2;  
}  

/* 优化"可叠加"标签样式 */  
.coupon-tag.stack-tag {  
  color: #ff9500;  
  background-color: rgba(255, 149, 0, 0.1);  
  border: 1rpx solid rgba(255, 149, 0, 0.3);  
  padding: 4rpx 12rpx;  
  font-weight: 500;  
}  

.coupon-right {  
  display: flex;  
  align-items: center;  
  justify-content: center;  
  width: 60rpx;  
  padding-left: 10rpx;  
}  

.select-icon {  
  width: 40rpx;  
  height: 40rpx;  
  border-radius: 50%;  
  border: 2rpx solid #ddd;  
  box-sizing: border-box;  
}  

.select-icon.selected {  
  border: 2rpx solid #e4393c;  
  background-color: #e4393c;  
  position: relative;  
}  

.select-icon.selected:after {  
  content: '';  
  position: absolute;  
  top: 50%;  
  left: 50%;  
  transform: translate(-50%, -50%);  
  width: 20rpx;  
  height: 12rpx;  
  border: 2rpx solid #fff;  
  border-top: none;  
  border-right: none;  
  transform: translate(-50%, -60%) rotate(-45deg);  
}  

.empty-coupon {  
  text-align: center;  
  padding: 60rpx 0;  
  color: #999;  
  font-size: 28rpx;  
  background: #fff;  
  border-radius: 12rpx;  
  margin: 20rpx 0;  
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);  
}  

.modal-footer {  
  padding: 20rpx 30rpx 40rpx;  
  background-color: #fff;  
  border-top: 1rpx solid #f0f0f0;  
}  

/* 新增：总折扣信息 */  
.total-discount {  
  text-align: center;  
  font-size: 28rpx;  
  color: #e4393c;  
  margin-bottom: 15rpx;  
  font-weight: 500;  
}  

.confirm-btn {  
  width: 100%;  
  height: 88rpx;  
  line-height: 88rpx;  
  background-color: #e4393c;  
  color: #fff;  
  font-size: 32rpx;  
  border-radius: 44rpx;  
  border: none;  
  font-weight: 500;  
}  

.confirm-btn::after {  
  border: none;  
}  

/* 优化不可用优惠券显示 */  
.coupon-item.disabled {  
  opacity: 0.8;  
  background: #f7f7f7;  
}  

.coupon-item.disabled .coupon-name,  
.coupon-item.disabled .coupon-time,  
.coupon-item.disabled .coupon-desc,  
.coupon-item.disabled .coupon-condition {  
  color: #999;  
}  

.coupon-item.disabled .coupon-tag {  
  color: #999;  
  background-color: rgba(153, 153, 153, 0.1);  
}