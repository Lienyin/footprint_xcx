.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #741A19;
}

/* 顶部背景图 */
.top-bg {
  width: 100%;
  height: auto;
  display: block;
}

/* 底部背景色区 */
.bottom-section {
  background-color: #741A19;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

/* 立即使用去下单按钮 - 红色 + 浅金黄色镶边 + 浅金黄色字体 */
.order-btn {
  background: linear-gradient(#e63946, #d62828);
  color: #FFE680;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  width: 90%;
  padding: 22rpx 0;
  margin-bottom: 20rpx;
  text-align: center;
  border: 3rpx solid #FFE680;
  line-height: 1;
  box-shadow: 
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3),
    0 4rpx 10rpx rgba(255, 230, 128, 0.4);
}

/* 内容框 - 深红色 */
.info-box {
  background-color: #8b2e2e;
  padding: 24rpx;
  border-radius: 18rpx;
  width: 90%;
  margin-bottom: 20rpx;
}

/* 文字内容 - 浅金黄色 + 更大 */
.info-text {
  font-size: 32rpx;
  color: #FFE680;
  line-height: 1.6;
  font-weight: 500;
}

/* 发红包按钮 - 稍大一点 */
.red-envelope-btn {
  background: linear-gradient(135deg, #FAF1C6 0%, #E7C077 50%, #F5E6A8 100%);
  color: #8b3a1a;
  font-size: 40rpx;
  font-weight: bold;
  border-radius: 100rpx;
  width: 90%;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  line-height: 1;
  box-shadow: 
    /* 外层发光 */
    0 0 10rpx rgba(231, 192, 119, 0.8),
    0 0 20rpx rgba(231, 192, 119, 0.6),
    0 0 30rpx rgba(231, 192, 119, 0.4),
    0 0 40rpx rgba(250, 241, 198, 0.3),
    /* 内侧高光 */
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9),
    inset 0 -2rpx 4rpx rgba(199, 164, 80, 0.3),
    /* 底部阴影 */
    0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  animation: glow 2s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

/* 发红包按钮反光条 */
.red-envelope-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.5),
    transparent
  );
  animation: shine 2.5s ease-in-out infinite;
  border-radius: 100rpx;
}

/* 按钮脉冲发光动画 */
@keyframes glow {
  0%, 100% {
    box-shadow: 
      0 0 10rpx rgba(231, 192, 119, 0.8),
      0 0 20rpx rgba(231, 192, 119, 0.6),
      0 0 30rpx rgba(231, 192, 119, 0.4),
      0 0 40rpx rgba(250, 241, 198, 0.3),
      inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9),
      inset 0 -2rpx 4rpx rgba(199, 164, 80, 0.3),
      0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  }
  50% {
    box-shadow: 
      0 0 15rpx rgba(231, 192, 119, 1),
      0 0 30rpx rgba(231, 192, 119, 0.8),
      0 0 45rpx rgba(231, 192, 119, 0.6),
      0 0 60rpx rgba(250, 241, 198, 0.4),
      inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9),
      inset 0 -2rpx 4rpx rgba(199, 164, 80, 0.3),
      0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  }
}

/* 反光条动画 */
@keyframes shine {
  0% {
    left: -100%;
  }
  50% {
    left: 100%;
  }
  100% {
    left: 100%;
  }
}