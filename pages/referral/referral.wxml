<view class="container">
  <!-- 顶部红色区域 -->
  <view class="header-section">
    <view class="page-title">推广赚佣金</view>
    
    <view class="total-commission">
      <text class="commission-label">累计佣金</text>
      <text class="commission-amount">¥{{totalCommission || '0.00'}}</text>
    </view>
    
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">已推广客户</text>
        <text class="stat-value">{{customerCount || 0}}人</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">可提现</text>
        <text class="stat-value">¥{{availableAmount || '0.00'}}</text>
      </view>
    </view>
  </view>

  <!-- 白色内容区域 -->
  <view class="content-section">
    <!-- 分享说明 -->
    <view class="share-intro">
      <text class="intro-title">分享给好友，客户下单你就赚</text>
      <text class="intro-subtitle">新客领58元券 · 首单最高奖励50元</text>
    </view>

    <!-- 3步轻松赚佣金 -->
    <view class="steps-section">
      <view class="section-header">
        <view class="header-line"></view>
        <text class="section-title">3步轻松赚佣金</text>
        <view class="header-line"></view>
      </view>
      
      <view class="steps-container">
        <view class="step-item">
          <view class="step-number">1</view>
          <view class="step-icon-wrapper">
            <image class="step-icon" src="/images/lianjie.png" mode="aspectFit"></image>
          </view>
          <text class="step-title">分享专属链接</text>
          <text class="step-desc">邀请好友领取优惠</text>
        </view>
        
        <view class="step-arrow">—</view>
        
        <view class="step-item">
          <view class="step-number">2</view>
          <view class="step-icon-wrapper">
            <image class="step-icon" src="/images/rmb_fh.png" mode="aspectFit"></image>
          </view>
          <text class="step-title">好友领58元券</text>
          <text class="step-desc">下单可用</text>
        </view>
        
        <view class="step-arrow">—</view>
        
        <view class="step-item">
          <view class="step-number">3</view>
          <view class="step-icon-wrapper">
            <image class="step-icon" src="/images/liwu.png" mode="aspectFit"></image>
          </view>
          <text class="step-title">订单奖励到账</text>
          <text class="step-desc">最高奖励50元</text>
        </view>
      </view>
    </view>

    <!-- 推广方式 -->
    <view class="promo-methods">
      <view class="methods-title">推广方式</view>
      
      <view class="method-cards">
        <button class="method-card share-btn" open-type="share">
          <image class="method-icon" src="/images/wx.png" mode="aspectFit"></image>
          <view class="method-info">
            <text class="method-name">分享给微信好友</text>
            <text class="method-desc">好友点击即可领取优惠</text>
          </view>
          <text class="method-arrow">></text>
        </button>
        
        <view class="method-card" bindtap="showPromoCode">
          <image class="method-icon" src="/images/qrcode.png" mode="aspectFit"></image>
          <view class="method-info">
            <text class="method-name">出示专属推广码</text>
            <text class="method-desc">客户扫码立即绑定</text>
          </view>
          <text class="method-arrow">></text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="bottom-tip">
      <image class="tip-icon" src="/images/laba.png" mode="aspectFit"></image>
      <text class="tip-text">客户首单后3个月内消费，奖励自动到账</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-buttons">
    <view class="btn-secondary" bindtap="showPromoCode">
      <text class="btn-text">查看推广码</text>
    </view>
    <button class="btn-primary share-btn" open-type="share">
      <text class="btn-text">立即分享</text>
    </button>
  </view>
</view>
