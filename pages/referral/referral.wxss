.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部红色区域 */
.header-section {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff3456 100%);
  padding: 40rpx 30rpx 60rpx;
  position: relative;
}

.page-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
}

.total-commission {
  text-align: center;
  margin-bottom: 40rpx;
}

.commission-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.commission-amount {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 白色内容区域 */
.content-section {
  background: #fff;
  margin-top: -30rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* 分享说明 */
.share-intro {
  text-align: center;
  margin-bottom: 40rpx;
}

.intro-title {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.intro-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 3步轻松赚佣金 */
.steps-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.header-line {
  flex: 1;
  height: 2rpx;
  background: #e0e0e0;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin: 0 20rpx;
}

.steps-container {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.step-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-number {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 36rpx;
  background: #ff3456;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.step-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: #fff3e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  margin-top: 10rpx;
}

.step-icon {
  width: 60rpx;
  height: 60rpx;
}

.step-title {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-align: center;
}

.step-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.step-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin: 0 10rpx;
  margin-top: 40rpx;
}

/* 推广方式 */
.promo-methods {
  margin-bottom: 30rpx;
}

.methods-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.method-cards {
  display: flex;
  gap: 20rpx;
}

.method-card {
  flex: 1;
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: none;
  margin: 0;
  text-align: left;
}

.method-card.share-btn {
  line-height: normal;
}

.method-card.share-btn::after {
  border: none;
}

.method-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
}

.method-info {
  flex: 1;
}

.method-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.method-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.method-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 底部提示 */
.bottom-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ff3456;
}

/* 底部按钮 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  border: 2rpx solid #ff3456;
  border-radius: 40rpx;
  padding: 20rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff3456 100%);
  border-radius: 40rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 52, 86, 0.3);
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn {
  line-height: normal;
}

.share-btn::after {
  border: none;
}

.btn-text {
  font-size: 28rpx;
  color: #ff3456;
  font-weight: bold;
}

.btn-primary .btn-text {
  color: #fff;
}
