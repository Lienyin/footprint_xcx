/* 自定义选择器样式 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.picker-container {
  width: 100%;
  background: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.picker-title {
  text-align: center;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.picker-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.picker-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-buttons {
  display: flex;
  margin-top: 20rpx;
}

.picker-button {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
}

