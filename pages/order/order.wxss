/* 滑动删除样式 */
.li-wrapper {
  position: relative;
  margin-bottom: 2rpx;
}

.li-content {
  width: 100%;
  background-color: #fff;
  transition: transform 0.3s ease;
  position: relative;
  z-index: 2;
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  width: 160rpx;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  z-index: 1;
  background-color: #e4393c; /* 改为主色调 */
}

.touch-move-active {
  transform: translateX(-160rpx) !important;
}

/* 保持原有样式不变 */
.li {
  width: 100%;
  background-color: #fff;
}

/* 清除订单按钮样式 */
.clearBtn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx; /* 调整高度与筛选按钮一致 */
  padding: 0 20rpx;
  margin-left: 12rpx;
  border-radius: 30rpx;
  background: linear-gradient(to right, #ff9a9e, #e4393c); /* 主色调渐变 */
  color: #fff;
  font-size: 24rpx;
  box-shadow: 0 4rpx 10rpx rgba(228, 57, 60, 0.3); /* 主色调阴影 */
  transition: all 0.3s ease;
}

.clearBtn text {
  margin-left: 4rpx; /* 文字和图标之间的间距 */
}

.clearBtn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 5rpx rgba(228, 57, 60, 0.2);
}

/* 确保按钮在一行内显示 */
.searchBox {
  flex-wrap: wrap;
}

/* 调整原有按钮样式，确保整体协调 */
.optionBtn {
  align-items: center;
  background-color: #fff;
  border-radius: 30rpx;
  display: flex;
  flex: 1;
  font-size: 28rpx;
  height: 54rpx;
  justify-content: center;
  margin-right: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1); /* 添加轻阴影，提升美观 */
}

.optionBtn .picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 10rpx;
}

.optionBtn text {
  flex: 1;
}

.picker-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
}

