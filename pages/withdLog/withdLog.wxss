page {
  background: #f9f9f9 !important;
}

.withdLog {
  min-height: 100vh;
  background: #f9f9f9;
}

/* 自定义标签栏 */
.custom-tabs-container {
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.custom-tabs {
  display: flex;
  width: 100%;
}

.tab-item {
  flex: 1;
  text-align: center;
  color: #666;
  font-size: 28rpx;
  transition: all 0.3s;
  position: relative;
  height: 88rpx;
  line-height: 88rpx;
}

.tab-item.active {
  color: #e4393c;  /* 使用您的主色调 */
  font-weight: bold;
}

/* 使用伪元素作为指示线 */
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #e4393c;  /* 使用您的主色调 */
}

/* 记录列表 */
.records-list {
  background-color: #f9f9f9;
  padding: 20rpx;
}

.record-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

.record-item::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 6rpx;
  background: #e4393c;
  opacity: 0.5;
  border-radius: 6rpx;
}

.record-icon {
  margin-right: 20rpx;
}

.icon-wechat {
  height: 60rpx;
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(228, 57, 60, 0.1);
  border-radius: 50%;
}

.icon-wechat image {
  width: 36rpx;
  height: 36rpx;
}

.record-content {
  flex: 1;
  width: 0; /* 解决flex子元素溢出问题 */
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.record-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
}

/* 状态标签 */
.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending {
  background-color: rgba(245, 158, 11, 0.1);
  color: #f59e0b;
}

.status-success {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.status-failed {
  background-color: rgba(228, 57, 60, 0.1);
  color: #e4393c;
}

/* 错误信息 */
.record-error {
  display: flex;
  align-items: flex-start;
  margin: 12rpx 0;
  background-color: rgba(228, 57, 60, 0.05);
  padding: 12rpx;
  border-radius: 8rpx;
}

.error-icon {
  margin-right: 8rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.error-icon image {
  width: 32rpx;
  height: 32rpx;
}

.error-text {
  font-size: 24rpx;
  color: #e4393c;
  line-height: 1.5;
}

/* 时间信息 */
.record-time-info {
  margin: 16rpx 0;
}

.time-label {
  color: #999;
  font-size: 24rpx;
  line-height: 1.6;
  display: flex;
}

.time-value {
  color: #666;
}

/* 金额显示 */
.record-amount {
  font-weight: 600;
  color: #333;
  font-size: 32rpx;
  text-align: right;
  margin-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.currency-symbol {
  font-size: 28rpx;
  font-weight: normal;
  margin-right: 4rpx;
}

.amount-value {
  font-size: 40rpx;
}

/* 加载更多相关样式 */
.loading-more {
  text-align: center;
  padding: 30rpx 0 50rpx;
}

.loading-text {
  color: #999;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #999;
  border-radius: 50%;
  border-top-color: transparent;
  margin-right: 12rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.no-more-text {
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-image {
  height: 200rpx;
  width: 200rpx;
  opacity: 0.7;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}