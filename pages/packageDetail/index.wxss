/* 新增<swiper>样式（模拟原u-swiper，高度调整为500rpx） */
.swiper-container {
  height: 500rpx; /* 调整为更小的高度，原750rpx -> 500rpx */
  width: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 或 aspectFit 以保持比例 */
}

/* 自定义指示器样式（右对齐，类似indicatorStyle="right: 20px"） */
.swiper-container ::-webkit-scrollbar { /* 隐藏滚动条，如果需要 */
  display: none;
}

.swiper-container .wx-swiper-dots {
  position: absolute;
  right: 20px !important; /* 右对齐 */
  bottom: 10px; /* 调整bottom以适应新高度 */
  display: flex;
  justify-content: flex-end;
  padding: 10rpx;
}

.swiper-container .wx-swiper-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}

.swiper-container .wx-swiper-dot-active {
  background: #fff;
  width: 24rpx;
}

/* 如果底部占位需要调整以匹配新高度（可选） */
.bottom-placeholder.data-v-16734b23 {  
  height: 220rpx; /* 保持不变，或根据需要缩小 */
