/* activity.wxss */
.container {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header .banner {
  width: 100%;
  height: 200rpx;
}

.content {
  width: 90%;
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: -50rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.qrcode-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-tips {
  color: #666;
  margin-bottom: 20rpx;
}

.qrcode {
  width: 400rpx;
  height: 400rpx;
}

.activity-rules {
  margin-top: 30rpx;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
}

.rule-title {
  font-weight: bold;
  margin-bottom: 10rpx;
}

.rule-list text {
  display: block;
  color: #666;
  margin-bottom: 10rpx;
}

.copy-btn {
  width: 80%;
  background-color: #07c160;
  color: white;
  margin-top: 30rpx;
}