/* pages/balance/balance.wxss */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* 顶部卡片 */
.balance-card {
  background: linear-gradient(to right, #e4393c, #f05b5f);
  color: white;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(228, 57, 60, 0.3);
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  margin: 30rpx;
}

.balance-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.balance-amount {
  font-size: 60rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 余额记录列表 */
.balance-list {
  padding: 0 30rpx;
}

.balance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: white;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid transparent;
  transition: all 0.3s ease;
}

.balance-item:hover {
  transform: translateX(4rpx);
}

.income-item {
  border-left-color: #e4393c;
}

.expense-item {
  border-left-color: #666;
}

.item-left {
  flex: 1;
}

.item-type {
  margin-bottom: 10rpx;
}

.type-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  border-radius: 6rpx;
}

.type-income {
  background-color: rgba(228, 57, 60, 0.1);
  color: #e4393c;
}

.type-expense {
  background-color: #f5f5f5;
  color: #666;
}

.item-desc {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  text-align: right;
}

.item-amount {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.item-balance {
  font-size: 24rpx;
  color: #666;
}

.income {
  color: #e4393c;
  font-weight: 600;
}

.expense {
  color: #666;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}

.load-more-btn {
  display: inline-block;
  padding: 12rpx 30rpx;
  background-color: rgba(228, 57, 60, 0.1);
  border-radius: 30rpx;
  color: #e4393c;
  transition: all 0.3s ease;
}

.load-more-btn:active {
  background-color: rgba(228, 57, 60, 0.2);
}

/* 无数据提示 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}