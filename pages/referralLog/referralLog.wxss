/* pages/referralLog/referralLog.wxss */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* 筛选摘要区域 */
.filter-summary {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.summary-left {
  display: flex;
  align-items: center;
}

.summary-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.filter-count {
  margin-left: 10rpx;
  background-color: #e4393c;
  color: white;
  font-size: 22rpx;
  height: 32rpx;
  min-width: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.active-filters {
  flex: 1;
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  padding: 0 20rpx;
  -webkit-overflow-scrolling: touch;
  margin-right: 10rpx;
}

.active-filters::-webkit-scrollbar {
  display: none;
}

.filter-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e4393c;
  background-color: rgba(228, 57, 60, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  white-space: nowrap;
}

.summary-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.summary-icon.expanded {
  transform: rotate(180deg);
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid #666;
  border-bottom: 2rpx solid #666;
  transform: rotate(45deg);
}

/* 筛选面板 */
.filter-container {
  margin: 0 30rpx 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.filter-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.clear-filter {
  font-size: 26rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.clear-icon {
  margin-left: 6rpx;
  font-weight: 600;
}

.filter-group {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.filter-group:last-of-type {
  border-bottom: none;
}

.filter-group-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.filter-option {
  position: relative;
  margin: 8rpx;
  padding: 14rpx 28rpx;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-option.active {
  background-color: rgba(228, 57, 60, 0.08);
  color: #e4393c;
  font-weight: 500;
  padding-right: 48rpx;
}

.check-icon {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #e4393c;
}

.check-icon::before {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 10rpx;
  border-right: 2rpx solid #fff;
  border-bottom: 2rpx solid #fff;
  top: 2rpx;
  left: 6rpx;
  transform: rotate(45deg);
}

/* 筛选操作按钮 */
.filter-actions {
  display: flex;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f2f2f2;
}

.filter-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.filter-apply {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(to right, #e4393c, #ff6b6b);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 8rpx rgba(228, 57, 60, 0.3);
}

/* 拉新记录列表 */
.referral-list {
  padding: 0 30rpx;
}

.referral-item {
  background-color: white;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-content {
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.status-info {
  flex: 1;
}

.status-tags {
  display: flex;
  margin-bottom: 12rpx;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.status-new {
  background-color: rgba(228, 57, 60, 0.1);
  color: #e4393c;
}

.status-not-new {
  background-color: #f5f5f5;
  color: #999;
}

.status-ordered {
  background-color: rgba(75, 137, 220, 0.1);
  color: #4b89dc;
}

.status-not-ordered {
  background-color: #f5f5f5;
  color: #999;
}

.order-info {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.order-label {
  color: #999;
}

.order-id {
  color: #333;
}

.reward-status {
  text-align: right;
  min-width: 160rpx;
}

.reward-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #e4393c;
  margin-bottom: 8rpx;
}

.reward-time {
  font-size: 22rpx;
  color: #999;
}

.reward-pending {
  font-size: 26rpx;
  color: #f5a623;
  font-weight: 500;
}

.reward-failed {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.reward-not-ordered {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.reward-note {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.failure-reason {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  max-width: 200rpx;
  white-space: normal;
  word-break: break-all;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(228, 57, 60, 0.1);
  border-top: 3rpx solid #e4393c;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 10rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.load-more-btn {
  display: inline-block;
  padding: 12rpx 30rpx;
  background-color: rgba(228, 57, 60, 0.1);
  border-radius: 30rpx;
  color: #e4393c;
  transition: all 0.3s ease;
}

.load-more-btn:active {
  background-color: rgba(228, 57, 60, 0.2);
}

/* 无数据提示 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.empty-action {
  padding: 12rpx 30rpx;
  background-color: rgba(228, 57, 60, 0.1);
  border-radius: 30rpx;
  color: #e4393c;
  font-size: 26rpx;
}