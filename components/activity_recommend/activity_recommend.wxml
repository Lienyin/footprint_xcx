<view wx:if="{{show}}" class="popup-mask" bindtap="onClose">
  <view class="popup-content" catchtap="stopEvent">
    <view class="popup-close" catchtap="onClose">×</view>

    
    <view class="popup-title">{{data.title}}</view>

    
    <view class="popup-text">{{data.content}}</view>

    
    <view class="popup-rewards">
      <block wx:for="{{data.rewards}}" wx:key="index">
        <view class="reward-item">{{item}}</view>
      </block>
    </view>

    
    <button class="popup-btn" hover-class="btn-hover" bindtap="onBtnClick">{{data.btnText}}</button>
  </view>
</view>